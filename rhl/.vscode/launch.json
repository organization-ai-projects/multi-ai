{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extension + LSP",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "preLaunchTask": "Build LSP",
            "outFiles": ["${workspaceFolder}/out/**/*.js"]
        },
        {
            "name": "Debug LSP",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/rhl-lsp",
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
